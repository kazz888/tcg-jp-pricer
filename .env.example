# ---------------------------------------------------------------
# Pipeline secrets. Used ONLY by scripts/ and GitHub Actions.
# Never prefix with PUBLIC_ — Astro ships PUBLIC_* to the browser.
# ---------------------------------------------------------------

# PRIMARY EU price source: Apify "cardmarket-price-guide" actor.
# Bulk reads of Cardmarket's official daily price files (EUR).
# Token: Apify Console -> Settings -> API & Integrations -> Personal API token
# Looks like: apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APIFY_TOKEN=

# OPTIONAL fallback: cardmarketapi.com per-card live lookup.
# Currently returning 502 on /card/{id} (vendor-side outage).
# Keep for live lookups of cards missing from the bulk index.
CARDMARKET_API_KEY=

# Optional FX overrides. Left empty, the pipeline fetches daily rates.
FX_USD_EUR=
FX_JPY_EUR=
